# Existing Railway + existing Supabase only; no new staging infrastructure.
# Reuse verified current values. Example values below are not deployment approval.
# Public client BUILD-TIME values. Copy to ignored .env.production.local and replace.
# No service_role/admin/private keys belong in this file or EXPO_PUBLIC_*.
EXPO_PUBLIC_WEB_APP_URL=https://play.your-domain.com
EXPO_PUBLIC_WEB_GAME_SERVER_URL=wss://boardgameserver-production.up.railway.app/lobby
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server RUNTIME reference: compare with existing service; do not overwrite its env.
# GAME_DOMAIN/WEB_DOMAIN are optional historical Compose values, not Railway requirements.
GAME_DOMAIN=game.your-domain.com
WEB_DOMAIN=play.your-domain.com
WEB_ALLOWED_ORIGINS=https://play.your-domain.com
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Compose mounts /data; on a managed host use its actual persistent mount directory.
STATE_DB_PATH=/data/boardgame.sqlite
STATS_DB_PATH=/data/stats.sqlite
RECONNECT_MS=300000
