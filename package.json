{
  "name": "boardgame",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "android:devices": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/open-android.ps1",
    "start": "npm run start --workspace=@boardgame/mobile --",
    "android": "npm run android --workspace=@boardgame/mobile --",
    "ios": "npm run ios --workspace=@boardgame/mobile --",
    "server": "npm run dev --workspace=@boardgame/server",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspace=@boardgame/server",
    "export:mobile": "npm run export --workspace=@boardgame/mobile",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-android-native.ps1"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0"
  },
  "overrides": {
    "expo-asset": "~58.0.19",
    "react-native": "0.88.1"
  }
}
