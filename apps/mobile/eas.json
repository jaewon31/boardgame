{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "node": "24.19.0",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "APP_ENV": "development" }
    },
    "preview": {
      "node": "24.19.0",
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_GAME_SERVER_URL": "wss://boardgameserver-production.up.railway.app/lobby"
      },
      "android": { "buildType": "apk" }
    },
    "production": {
      "node": "24.19.0",
      "environment": "production",
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_GAME_SERVER_URL": "wss://boardgameserver-production.up.railway.app/lobby"
      },
      "autoIncrement": true
    }
  },
  "submit": { "production": {} }
}
