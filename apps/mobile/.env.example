# Development defaults to the Metro host on port 3000.
# For a physical device, use your PC's LAN IP and run the game server on that PC.
# EXPO_PUBLIC_GAME_SERVER_URL=ws://192.168.0.10:3000/lobby
# Production requires a deployed wss:// endpoint. Never put secrets in EXPO_PUBLIC_*.
# Optional browser-only override; native continues using GAME_SERVER_URL.
# EXPO_PUBLIC_WEB_GAME_SERVER_URL=ws://localhost:3000/lobby
# On a phone browser, localhost means that phone: use the server PC's LAN host.
# HTTPS pages require wss://, including during development.
# Optional public web origin used by invitation links; HTTPS required in release.
# EXPO_PUBLIC_WEB_APP_URL=https://play.your-domain.com
