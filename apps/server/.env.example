PORT=3000
HOST=0.0.0.0
# Required in production: use an encrypted persistent disk, one server process.
STATE_DB_PATH=./data/boardgame.sqlite
RECONNECT_MS=300000
MAX_ROOMS=100
MAX_CONNECTIONS=240
MAX_CONNECTIONS_PER_IP=24
# Trust only proxies whose network access you control. Never use client-supplied headers directly.
TRUSTED_PROXY_IPS=

# Required in production; local dev reads public values from apps/mobile/.env.local.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
